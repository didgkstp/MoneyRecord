<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingVertical="12dp">

    <!-- 분류별 색상 동그라미 -->
    <View
        android:id="@+id/viewColorDot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:background="@drawable/bg_color_dot" />

    <!-- 분류명 (식비, 주거, 교통, 통신, 의료, 여가 등) -->
    <TextView
        android:id="@+id/tvLegendCategoryName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:text="🍚 식비"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- 퍼센트 (%) -->
    <TextView
        android:id="@+id/tvLegendPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_badge_rounded"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="38.5%"
        android:textColor="@color/primary_blue"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- 지출 금액 (원) -->
    <TextView
        android:id="@+id/tvLegendAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:minWidth="85dp"
        android:text="71,300원"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
